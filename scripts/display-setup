#!/bin/bash

# Open arandr
arandr

# Re-apply the current wallpaper to cover any new monitors
CACHE_WP="$HOME/.cache/wallust/wallpaper"
if [ -f "$CACHE_WP" ]; then
    feh --bg-scale "$(cat "$CACHE_WP")"
fi

# Wait for arandr to close, then ask for profile name using dmenu
PROFILE=$(echo "" | dmenu -p "Save autorandr profile as (or press Esc to cancel):")

# If a name was entered, save the profile
if [ -n "$PROFILE" ]; then
    autorandr --save "$PROFILE" --force
    notify-send -a 'System' -i 'video-display' "Monitor Setup" "Profile '$PROFILE' saved successfully!"
fi