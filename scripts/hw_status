#!/usr/bin/env bash
# Description: Dynamically detect hardware names for slstatus

case $1 in
    wifi_essid)
        # Find active wifi interface and get ESSID
        INTERFACE=$(ip link | grep -E 'wlan|wlp' | awk '{print $2}' | tr -d ':' | head -n 1)
        # If connected, show ESSID, else show 'Disconnected'
        [ -n "$INTERFACE" ] && iwgetid -r "$INTERFACE" || echo "off"
        ;;
    wifi_perc)
        # Find active wifi interface and get signal strength
        INTERFACE=$(ip link | grep -E 'wlan|wlp' | awk '{print $2}' | tr -d ':' | head -n 1)
        [ -n "$INTERFACE" ] && awk 'NR==3 {print int($3*100/70)}' /proc/net/wireless || echo "0"
        ;;
    battery)
        #   > 20%  -> normal color  |  11-20% -> amber  |  <= 10% -> red
        #   charging/full -> a green bolt icon is shown before the reading
        BAT_WARN="#ffb52a"   # amber (11-20%)
        BAT_CRIT="#ff3333"   # red   (<=10%)
        BAT_CHG="#9ece6a"    # green (charging bolt)
        # Find the first available battery (BAT0 or BAT1)
        BAT=$(ls /sys/class/power_supply/ | grep BAT | head -n 1)
        if [ -z "$BAT" ]; then
            printf 'PWR n/a | '
            exit 0
        fi
        CAP=$(cat "/sys/class/power_supply/$BAT/capacity")
        # Nerd Font bolt icon whenever AC power is connected (any Mains supply online)
        CHG=""
        for ps in /sys/class/power_supply/*/; do
            if [ "$(cat "$ps/type" 2>/dev/null)" = "Mains" ] && [ "$(cat "$ps/online" 2>/dev/null)" = "1" ]; then
                CHG="^c$BAT_CHG^$(printf '')^d^ "
                break
            fi
        done
        if [ "$CAP" -le 10 ]; then
            printf '%s^c%s^PWR %s%%^d^ | ' "$CHG" "$BAT_CRIT" "$CAP"
        elif [ "$CAP" -le 20 ]; then
            printf '%s^c%s^PWR %s%%^d^ | ' "$CHG" "$BAT_WARN" "$CAP"
        else
            printf '%sPWR %s%% | ' "$CHG" "$CAP"
        fi
        ;;
    temp)
        # Find the first thermal zone temperature
        if [ -f /sys/class/thermal/thermal_zone0/temp ]; then
            echo $(( $(cat /sys/class/thermal/thermal_zone0/temp) / 1000 ))
        else
            echo "n/a"
        fi
        ;;
esac